# Copy to .env:  cp .env.example .env
# These values are safe local-development defaults. Never commit a real .env.

# --- PostgreSQL (used by the db service in Docker Compose) ---
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# --- Backend ---
# Used when running the backend WITHOUT Docker (points at a local Postgres).
# Docker Compose builds its own URL from the POSTGRES_* values above (host "db").
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
# Comma-separated browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Optional: your UTC offset in minutes (e.g. 330 for India, -300 for New York)
# so the seed script places "today" follow-ups inside YOUR day. Empty = server time zone.
SEED_UTC_OFFSET_MINUTES=

# --- Frontend ---
# Where the browser reaches the API. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Host ports (Docker Compose) ---
API_PORT=8000
FRONTEND_PORT=3000
